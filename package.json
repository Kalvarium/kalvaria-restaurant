{
  "name": "kalvaria-restaurant",
  "version": "0.0.0",
  "private": true,
  "description": "Kalvaria restaurant monorepo — Next.js web app + Strapi CMS",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=20 <=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:cms": "turbo run dev --filter=cms",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}

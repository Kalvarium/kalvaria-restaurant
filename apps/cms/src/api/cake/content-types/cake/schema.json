{
  "kind": "collectionType",
  "collectionName": "cakes",
  "info": {
    "singularName": "cake",
    "pluralName": "cakes",
    "displayName": "Cake",
    "description": "The product catalog — one entry per cake or item the café offers (Medovník, Punčová torta, coffee…). Holds the photos, name, description and price. Display only: cakes are shown on the site but not sold online. Edited once here, they appear anywhere a Cake Grid block is placed. Use 'available' to hide an item without deleting it."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "allergens": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "currency": {
      "type": "enumeration",
      "enum": [
        "EUR",
        "USD"
      ],
      "default": "EUR",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pricePrefix": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "priceUnit": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images"
      ],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "badge": {
      "type": "component",
      "repeatable": false,
      "component": "shared.badge",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "available": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}

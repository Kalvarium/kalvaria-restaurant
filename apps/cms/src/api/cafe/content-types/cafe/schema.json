{
  "kind": "collectionType",
  "collectionName": "cafes",
  "info": {
    "singularName": "cafe",
    "pluralName": "cafes",
    "displayName": "Cafe",
    "description": "The café menu — one entry per drink or item (coffee, hot chocolate, tea…). Holds the photo, name, description, price and a favourite note. Display only, like the Cake catalog. Edited once here, items appear anywhere a Cafe Grid block is placed. Use 'available' to hide an item without deleting it, and 'featured' to surface it in featured grids."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "favorite": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "currency": {
      "type": "enumeration",
      "enum": ["EUR"],
      "default": "EUR",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "pricePrefix": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "priceUnit": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "image": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"],
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "badge": {
      "type": "component",
      "repeatable": false,
      "component": "shared.badge",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "wide": {
      "type": "boolean",
      "default": false,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "available": {
      "type": "boolean",
      "default": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}

{
  "collectionName": "components_sections_cake_grids",
  "info": {
    "displayName": "Cake Grid",
    "icon": "grid",
    "description": "Shows cakes from the catalog. Pick specific cakes in 'cakes' to curate and order them; leave it empty to fall back to all available cakes."
  },
  "options": {},
  "attributes": {
    "background": {
      "type": "enumeration",
      "enum": [
        "surface",
        "cream",
        "green",
        "brown"
      ]
    },
    "heading": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "cakes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cake.cake"
    },
    "limit": {
      "type": "integer",
      "default": 6,
      "min": 1
    },
    "ctaHeading": {
      "type": "string"
    },
    "ctaBody": {
      "type": "text"
    },
    "ctaButton": {
      "type": "component",
      "repeatable": false,
      "component": "shared.link"
    },
    "orderLabel": {
      "type": "string",
      "default": "Order"
    },
    "callLabel": {
      "type": "string",
      "default": "Call"
    },
    "allergensLabel": {
      "type": "string",
      "default": "Allergens"
    },
    "emptyText": {
      "type": "string",
      "default": "We are currently preparing an offer."
    }
  }
}

{
  "collectionName": "components_sections_cafe_grids",
  "info": {
    "displayName": "Cafe Grid",
    "icon": "grid",
    "description": "Shows café menu items from the Cafe collection. Pick specific items in 'cafes' to curate and order them; leave it empty to fall back to all available items."
  },
  "options": {},
  "attributes": {
    "background": {
      "type": "enumeration",
      "enum": [
        "surface",
        "cream",
        "green",
        "brown"
      ]
    },
    "cafes": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::cafe.cafe"
    },
    "reserveLabel": {
      "type": "string",
      "default": "Reserve a table"
    },
    "callLabel": {
      "type": "string",
      "default": "Call"
    },
    "favoriteLabel": {
      "type": "string",
      "default": "Favorite"
    },
    "emptyText": {
      "type": "string",
      "default": "We are currently preparing our menu."
    }
  }
}
